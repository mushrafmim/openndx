# Server Configuration
PORT=4000
CONFIG_PATH=./config/config.json

# Consumer token validation (see AUTHENTICATION.md). Values for the local ThunderID,
# whose `iss` is its base URL (thunderid/deployment.yaml server.public_url).
IDP_JWKS_URL=http://localhost:8090/oauth2/jwks
IDP_ISSUER=http://localhost:8090
IDP_AUDIENCE=http://api.openndx.local

# Observability
SERVICE_NAME=orchestration-engine
SERVICE_VERSION=dev
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=true

# Audit
ENABLE_AUDIT=true
