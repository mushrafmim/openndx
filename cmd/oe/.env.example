# Server Configuration
PORT=4000
CONFIG_PATH=./config/config.json

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=orchestration_engine
DB_SSLMODE=disable

# Consumer token validation (see AUTHENTICATION.md). IDP_JWKS_URL and IDP_ISSUER
# default to IDP_BASE_URL's /oauth2/jwks and /oauth2/token.
IDP_BASE_URL=http://localhost:8090
IDP_AUDIENCE=http://api.openndx.local

# Observability
SERVICE_NAME=orchestration-engine
SERVICE_VERSION=dev
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=true

# Audit
ENABLE_AUDIT=true
